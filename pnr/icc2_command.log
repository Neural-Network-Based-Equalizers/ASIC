gui_zoom -window [gui_get_current_window -types Layout -view] -factor 2 -at_point {119.870 103.460}
gui_zoom -window [gui_get_current_window -types Layout -view] -factor 2 -at_point {119.870 103.460}
gui_zoom -window [gui_get_current_window -types Layout -view] -factor 0.5 -at_point {119.870 103.460}
win_select_objects -slct_targets global -at {438.540 69.055} -radius 0.8192
win_select_objects -slct_targets global -at {447.550 2.700} -radius 0.8192
create_tap_cells     -lib_cell saed90nm_max/DCAP     -pattern  every_other_row      -distance 10
report_ports  [all_inputs]  > ${REPORT_DIR}/fp_input_ports.rpt
