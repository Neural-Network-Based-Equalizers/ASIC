set_attribute [get_site_defs $site_name] symmetry {Y}
initialize_floorplan     -core_utilization  0.55     -shape             R        -orientation       N        -core_offset       {60 60 60 60}     -flip_first_row    false     -side_ratio        {1 1}
set_block_pin_constraints     -allowed_layers    {M3}     -sides             {1}
place_pins -ports [get_ports {in_I in_Q valid_in}]
