set_block_pin_constraints     -allowed_layers    {M4}     -sides             {4}      -corner_keepout_num_tracks 2
place_pins -ports [get_ports {rst_n}]
remove_placement_blockages -all
remove_placement_blockages -all
create_placement_blockage     -name   corner_BL     -type   hard     -boundary {{0 0} {15 15}}
create_placement_blockage     -name   corner_BR     -type   hard     -boundary {{[expr [get_attribute [current_block] boundary_bbox_ur_x] - 15] 0}                {[get_attribute [current_block] boundary_bbox_ur_x] 15}}
create_placement_blockage     -name   corner_TL     -type   hard     -boundary {{0 [expr [get_attribute [current_block] boundary_bbox_ur_y] - 15]}                {15 [get_attribute [current_block] boundary_bbox_ur_y]}}
create_placement_blockage     -name   corner_TR     -type   hard     -boundary {{[expr [get_attribute [current_block] boundary_bbox_ur_x] - 15]                 [expr [get_attribute [current_block] boundary_bbox_ur_y] - 15]}                {[get_attribute [current_block] boundary_bbox_ur_x]                 [get_attribute [current_block] boundary_bbox_ur_y]}}
create_placement_blockage     -name   corner_BL     -type   hard     -boundary {{0 0} {15 15}}
remove_placement_blockages -all
create_placement_blockage     -name   corner_BL     -type   hard     -boundary {{0 0} {15 15}}
remove_placement_blockages -all
create_placement_blockage     -name   corner_BL     -type   hard     -boundary {{0 0} {15 15}}
create_placement_blockage     -name   corner_BR     -type   hard     -boundary {{[expr [get_attribute [current_block] boundary_bbox_ur_x] - 15] 0}                {[get_attribute [current_block] boundary_bbox_ur_x] 15}}
