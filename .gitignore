# ============================================================
# .gitignore for ASIC project
# ============================================================

# --- Standard Cell Libraries (large PDK files — not committed)
standard_cell_libraries/

# --- Synthesis work directories
syn/script/work/
syn/output/

# --- PnR design libraries and outputs (binary, large)
pnr/*/output/
pnr/*/report/

# --- Extraction (StarRC) directories
qor/rcxt/*/star/
qor/rcxt/*/star_cmd/

# --- Tool-generated lock and binary databases
**/*.ndm
**/*.ndm.lock
**/*.dlib/
**/*.dlib.lock
**/*.errdm/

# --- Layout, Netlist, and Parasitic outputs (Huge)
*.gds
*.gds.gz
*.spef
*.spef.gz
*.def
*.def.gz

# --- Large log and text files
*.log
*.txt
!README.txt

# --- Report files
*.rpt

# --- Tool temp / run directory artifacts
pnr/*/run/*.tcl.bak
pnr/*/run/*.cmd
pnr/*/run/*.err

# --- DFT & Formality outputs
dft/output/
formality/output/
formality/fv/

# --- Misc OS & Tool artifacts
*.DS_Store
.DS_Store
*.swp
*.swo
*~

# --- Large Documents / Media (excluding our diagram)
*.pdf
!ASIC_ECO_Cycle_Textbook.pdf
*.jpg
*.jpeg
*.png
!ASIC_ECO_Cycle_Textbook.png
*.docx
